 "beats": [
  {
   "id": "b1",
   "start": 0.0,
   "end": 6.4,
   "spoken_text": "Có những người chỉ còn cách thành công đúng một nhát cuốc… nhưng lại bỏ cuộc.",
   "meaning": "Thành công gần kề nhưng bỏ cuộc",
   "emotional_intent": "tò mò, tiếc nuối",
   "narrative_function": "hook",
   "visual_type": "scene",
   "rationale": "Cận cuốc chim cắm xuống đất mở ra ẩn dụ đào vàng",
   "asset_ids": [
    "s1"
   ],
   "visual_cue_word_ids": [
    "w11",
    "w15"
   ],
   "keywords": [
    "bỏ cuộc"
   ]
  },
  {
   "id": "b2",
   "start": 6.4,
   "end": 10.192,
   "spoken_text": "Ngày xưa, có hai người cùng đi tìm vàng.",
   "meaning": "Giới thiệu hai nhân vật cùng mục tiêu",
   "emotional_intent": "kể chuyện",
   "narrative_function": "setup",
   "visual_type": "scene",
   "rationale": "Hai người, hai hố đào: đặt nền cho so sánh",
   "asset_ids": [
    "s2"
   ],
   "visual_cue_word_ids": [
    "w20",
    "w25"
   ],
   "keywords": []
  },
  {
   "id": "b3",
   "start": 10.192,
   "end": 15.897,
   "spoken_text": "Người thứ nhất đào rất sâu. Nhưng ngày qua ngày, vẫn chẳng thấy gì.",
   "meaning": "Người A cố gắng nhưng chưa thấy kết quả",
   "emotional_intent": "mệt mỏi",
   "narrative_function": "conflict",
   "visual_type": "scene",
   "rationale": "Thấy A đào sâu, mồ hôi, chán nản đúng lời 'chẳng thấy gì'",
   "asset_ids": [
    "s3"
   ],
   "visual_cue_word_ids": [
    "w29",
    "w38"
   ],
   "keywords": []
  },
  {
   "id": "b4",
   "start": 15.897,
   "end": 23.97,
   "spoken_text": "Anh ta nản lòng, vứt cuốc và bỏ đi. Anh không hề biết, vàng chỉ còn cách mình một gang tay.",
   "meaning": "A bỏ cuộc khi vàng chỉ còn một gang tay",
   "emotional_intent": "tiếc nuối, trớ trêu",
   "narrative_function": "turning_point",
   "visual_type": "scene",
   "rationale": "Cảnh cắt lớp đất cho khán giả THẤY vàng ngay dưới chỗ A dừng",
   "asset_ids": [
    "s4",
    "s5"
   ],
   "visual_cue_word_ids": [
